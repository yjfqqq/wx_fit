# 复制为 .env 后修改

# ---- 服务 ----
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ---- 数据库 ----
# mysql：需要本机装了 MySQL 8
# sqlite：本机没装 MySQL 时先跑起来体验，数据落在 server/fit_app.db
DB_ENGINE=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fit_app

# ---- JWT ----
JWT_SECRET=please-change-this-to-a-random-string
JWT_EXPIRE_DAYS=30

# ---- 微信小程序 ----
WX_APPID=
WX_SECRET=
# 没有 AppID/AppSecret 时设为 true，登录接口直接返回固定 openid，本地可跑通全部业务
WX_MOCK_LOGIN=true
MOCK_OPENID=mock_openid_0001

# ---- 每日打卡提醒（订阅消息）----
# 小程序后台「功能→订阅消息」申领模板后，把模板 ID 填到这里；留空则提醒功能整体关闭
# 模板字段映射见 app/services/wx_message.py 的 build_remind_data()
WX_TEMPLATE_ID=
# 每天几点推送（0-23）
WX_REMIND_HOUR=21

# ---- 跨域 ----
CORS_ORIGINS=*
