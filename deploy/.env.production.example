# 复制为 .env 后修改（docker compose 自动读取）

# 数据库 root 密码（务必改成强随机串）
DB_PASSWORD=change-me-to-a-strong-password
DB_NAME=fit_app

# JWT 签名密钥（务必改成强随机串，泄露=所有人可伪造登录）
JWT_SECRET=change-me-to-a-random-long-string

# 微信凭据（与本地 server/.env 相同）
WX_APPID=wxc3ccac8c75be2ede
WX_SECRET=your-app-secret

# 每日打卡提醒：申领模板后填入（留空则关闭提醒功能）
WX_TEMPLATE_ID=
WX_REMIND_HOUR=21
